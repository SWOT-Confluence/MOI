START_INDEX=$(( ${OFFSET:-0} + SLURM_ARRAY_TASK_ID * ${INDEX_RANGE:-1} ))
END_INDEX=$(( START_INDEX + ${INDEX_RANGE:-1} - 1 ))

if [[ -n "$MAX_LIMIT" ]]; then
    (( END_INDEX >= MAX_LIMIT )) && END_INDEX=$(( MAX_LIMIT - 1 ))
fi

for (( idx=START_INDEX; idx<=END_INDEX; idx++ )); do
  {{ container_cmd.run }} run \
    --env AWS_BATCH_JOB_ID='foo' \
    {{ container_cmd.bind }} {{ mnt_dir }}/input:/mnt/data/input \
    {{ container_cmd.bind }} {{ flpe_bind_dir }}:/mnt/data/flpe:ro \
    {{ container_cmd.bind }} {{ mnt_dir }}/moi:/mnt/data/output \
    {{ container_cmd.bind }} {{ module_dir }}/CalValSeparation_basin_stratified_v2.csv:/app/CalValSeparation_basin_stratified_v2.csv \
    {{ container_cmd.bind }} {{ module_dir }}/corridors:/app/corridors:ro \
    {{ optional_binds | join(' \\\n    ') }} \
    {{ sif_dir }}/moi.sif \
    -j basin.json \
    -v \
    -b {{ module.basin_type }} \
    --use-corridors \
    --corridors-dir /app/corridors \
    -i ${idx}
done
